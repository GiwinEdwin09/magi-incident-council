# Copy to .env (repo root). Every integration is optional: empty values fall back to local behavior.

# ---- LLM (no key => scripted mode: deterministic agents, no API calls)
# LLM_PROVIDER: openai (OpenAI or any OpenAI-compatible server) | anthropic | auto
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=
OPENAI_REASONING_EFFORT=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# Optional per-agent override as provider:model, e.g. MODEL_CASPER=anthropic:claude-opus-5-5
MODEL_MELCHIOR=
MODEL_BALTHASAR=
MODEL_CASPER=
MODEL_SCRIBE=
EFFORT_DEFAULT=low
LLM_TIMEOUT_S=90
# Output token budget per model call (reasoning models spend part of it on hidden reasoning)
LLM_MIN_OUTPUT_TOKENS=32000
# Native tool calls per agent per phase (official OpenAI Responses API)
LLM_MAX_TOOL_CALLS=4

# ---- Modes: auto (live if key set, else scripted) | scripted | live | record | replay
MAGI_MODE=auto
SCRIPTED_DELAY_S=0.9
ANONYMIZE_PEERS=true
MAX_ROUNDS=3
DECISION_TIME_BUDGET_S=180
CONFIRM_TIMEOUT_S=120

# ---- Security
MAGI_SIGNING_KEY=change-me-long-random-string
N8N_SHARED_SECRET=
ELEVENLABS_TOOL_SECRET=
AGENT_TOKEN_MELCHIOR=
AGENT_TOKEN_BALTHASAR=
AGENT_TOKEN_CASPER=

# ---- n8n deploy script (python3 n8n/deploy.py)
N8N_API_KEY=
SLACK_BOT_TOKEN=

# ---- Storage: the incident event log. On Render, point it at the persistent disk: /data/magi.sqlite
# DB_PATH=backend/magi.sqlite

# ---- Tunnel (scripts/tunnel.sh): ngrok if NGROK_AUTHTOKEN is set, else cloudflared quick tunnel
NGROK_AUTHTOKEN=
NGROK_DOMAIN=

# ---- Integrations (backend must be reachable from n8n / ElevenLabs: deploy it or use a cloudflared tunnel)
# N8N_BASE_URL is the instance root, e.g. https://you.app.n8n.cloud (no /webhook). See n8n/README.md.
PUBLIC_BACKEND_URL=http://127.0.0.1:8787
N8N_BASE_URL=
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_PHONE_NUMBER_ID=
ONCALL_NAME=Alex
ONCALL_PHONE=
