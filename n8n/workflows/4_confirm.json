        }
      },
      "webhookId": "0b6fab08-4bdc-5026-90db-23f2c85a3812"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Webhook').first().json.body.callback }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ approved: $json.data ? $json.data.approved === true : false, by: 'Slack' }) }}",
        "options": {
          "timeout": 10000,
          "response": {
            "response": {
              "neverError": true
            }
          }
