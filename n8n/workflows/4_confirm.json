        "approvalOptions": {
          "values": {
            "approvalType": "double",
            "approveLabel": "Approve",
            "disapproveLabel": "Deny"
          }
        },
        "options": {
          "limitWaitTime": {
            "values": {
              "limitType": "afterTimeInterval",
              "resumeAmount": 2,
              "resumeUnit": "minutes"
            }
          }
        }
      },
      "id": "e3af1f2c-6c4f-5302-b595-f630ee67edfc",
      "name": "Ask on-call in Slack",
